# Secrets (never commit real keys)
.env
*.env
*.env.local
backend/.env
frontend/.env
code/backend/.env
code/frontend/.env

# Python
__pycache__/
*.pyc
venv/
backend/venv/
code/backend/venv/
.pytest_cache/
code/backend/.pytest_cache/
*.egg-info/

# Database and user data
*.db
*.db-wal
*.db-shm
backend/*.db*
code/backend/*.db*
backend/uploads/*
code/backend/uploads/*
!backend/uploads/.gitkeep
!code/backend/uploads/.gitkeep

# Generated test fixtures (recreated by tests/make_samples.py)
backend/tests/samples/
code/backend/tests/samples/

# Node
node_modules/
frontend/node_modules/
code/frontend/node_modules/
frontend/dist/
code/frontend/dist/

# OS / editor
.DS_Store
